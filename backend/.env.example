DATABASE_URL=postgresql+asyncpg://username:password@localhost:5432/armorify_ppe
DB_SCHEMA=armorify
APP_NAME="Armorify PPE API"
ENVIRONMENT=production
DEBUG=false
SECRET_KEY=your-secret-key-here
JWT_SECRET_KEY=your-jwt-secret-key-here
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
# CORS allowed origins (comma-separated for production)
ALLOWED_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]
# Published shipping policy: 30,000 VND below 500,000 VND after promotions.
# An empty shipping fee explicitly disables checkout; empty threshold disables free shipping.
CHECKOUT_SHIPPING_FEE=30000
CHECKOUT_FREE_SHIPPING_THRESHOLD=500000
